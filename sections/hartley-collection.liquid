{{ 'hartley-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hartley-collection.js' | asset_url }}" defer></script>

{% assign featured_collection = section.settings.collection %}

<section
  id="hartley-collection-{{ section.id }}"
  class="hartley-collection"
  aria-labelledby="hartley-heading-{{ section.id }}"
>
  <div class="hartley-collection__container">

    <div class="hartley-collection__header" data-hartley-reveal>
      {% if section.settings.eyebrow != blank %}
        <span class="hartley-collection__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </span>
      {% endif %}

      <h2
        id="hartley-heading-{{ section.id }}"
        class="hartley-collection__title"
      >
        {{ section.settings.heading | escape }}
      </h2>

      {% if section.settings.description != blank %}
        <div class="hartley-collection__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    {% if featured_collection != blank %}
      <div class="hartley-collection__grid">

        {% for product in featured_collection.products
          limit: section.settings.product_limit
        %}
          <article
            class="hartley-product"
            data-hartley-reveal
          >
            <a
              href="{{ product.url }}"
              class="hartley-product__link"
            >
              <div class="hartley-product__image-wrap">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 750, 900',
                      sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw',
                      class: 'hartley-product__image'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'hartley-product__placeholder' }}
                {% endif %}
              </div>

              <div class="hartley-product__details">
                <h3 class="hartley-product__name">
                  {{ product.title | escape }}
                </h3>

                <span class="hartley-product__price">
                  {{ product.price | money }}
                </span>
              </div>
            </a>
          </article>
        {% endfor %}

      </div>

      {% if section.settings.show_button %}
        <div class="hartley-collection__footer">
          <a
            href="{{ featured_collection.url }}"
            class="hartley-collection__button"
          >
            {{ section.settings.button_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      {% endif %}
    {% elsif request.design_mode %}
      <p class="hartley-collection__empty">
        Select a collection in the section settings to display products.
      </p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Hartley Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE EDIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objects for Considered Living"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A curated selection of timeless pieces, thoughtfully chosen for the spaces we call home.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show collection button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the Collection"
    }
  ],
  "presets": [
    {
      "name": "Hartley Collection"
    }
  ]
}
{% endschema %}